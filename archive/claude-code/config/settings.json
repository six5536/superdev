{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "superdev hook validate",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "superdev hook run",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {}
}
