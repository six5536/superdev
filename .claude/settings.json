{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "superdev aokf hook validate",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "mise exec http:rtk -- rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {}
}
