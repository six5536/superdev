# The SOKF parity fixtures are parsed byte-for-byte and compared against
# golden output, so their line endings must survive a Windows checkout.
crates/lib/superdev-core/tests/fixtures/** -text

# superdev-owned files are compared byte-for-byte against content embedded
# in the binary, so their line endings must survive a Windows checkout. The
# patterns track the ownership boundary rather than today's file list: a
# component that starts writing a new file gets the protection with it.
.claude/skills/** -text
.agents/** -text
knowledge/templates/** -text
.miserc.toml -text
mise.*.toml -text
pack/** -text
