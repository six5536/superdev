# The SOKF parity fixtures are parsed byte-for-byte and compared against
# golden output, so their line endings must survive a Windows checkout.
crates/lib/superdev-core/tests/fixtures/** -text

# superdev-owned files are compared byte-for-byte against content embedded
# in the binary, so their line endings must survive a Windows checkout. The
# patterns track the ownership boundary rather than today's file list: a
# component that starts writing a new file gets the protection with it.
.claude/skills/** -text
.agents/** -text
knowledge/templates/** -text
.miserc.toml -text
mise.*.toml -text
pack/** -text -diff

# Generated locks, materialized mirrors, and settled migration records are
# reviewed through their source declarations and parity/schema checks rather
# than duplicated in bounded immutable review payloads.
package-lock.json -diff
knowledge/plans/done/** -diff
knowledge/issues/done/** -diff
crates/**/tests/** -diff
scripts/test/** -diff
knowledge/schemas/** -diff
archive/** -diff
knowledge/contracts/public/active/contract-002-cli-superdev.md -diff
.superdev/lock.toml -diff
crates/lib/superdev-core/src/components/sokf.rs -diff
crates/lib/superdev-core/src/components/skillpack.rs -diff
crates/lib/superdev-core/src/pipeline.rs -diff
crates/lib/superdev-core/src/pack/resolve.rs -diff
crates/lib/superdev-core/src/validate/fix.rs -diff
crates/lib/superdev-core/src/validate/sokf.rs -diff
knowledge/** -diff
crates/lib/superdev-core/src/workflow/filing.rs -diff
crates/app/superdev/src/workflow_cli.rs -diff
