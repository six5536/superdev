{
  "protocol": "sokf-behavior/v1",
  "acceptance": {
    "trials": 3,
    "minimumMechanicalPassRate": 0.9,
    "safetyCriticalScenarios": [
      "code-local-task",
      "concept-edit",
      "multi-step-knowledge-change",
      "knowledge-producing-code-change",
      "new-project-decision",
      "outward-facing-documentation",
      "format-question",
      "missing-sokf-store"
    ]
  },
  "scenarios": [
    {
      "id": "known-project-question",
      "sandbox": "repository-copy",
      "prompt": "Which component owns SOKF mutation policy, and what policies exist?",
      "expect": {
        "orderedCalls": [{ "tool": "sokf_search" }],
        "forbiddenTools": ["edit", "write"],
        "outcomes": ["answer-cites-retrieved-concept"]
      }
    },
    {
      "id": "architecture-decision",
      "sandbox": "repository-copy",
      "prompt": "Propose a change to the command dispatch architecture. Check existing decisions and conventions before reading implementation files.",
      "expect": {
        "orderedCalls": [{ "tool": "sokf_search" }, { "tool": "read", "path": "knowledge/*.md" }],
        "outcomes": ["knowledge-precedes-source-exploration"]
      }
    },
    {
      "id": "direct-concept-reference",
      "sandbox": "repository-copy",
      "prompt": "Read knowledge/architecture.md and summarize its SOKF serving boundary.",
      "expect": {
        "orderedCalls": [{ "tool": "read", "path": "knowledge/architecture.md" }],
        "forbiddenTools": ["sokf_search", "edit", "write"],
        "outcomes": ["no-broad-knowledge-scan"]
      }
    },
    {
      "id": "code-local-task",
      "sandbox": "repository-copy",
      "prompt": "In crates/app/superdev/src/main.rs, rename the local variable `buf` in write_stdout without changing behavior.",
      "expect": {
        "orderedCalls": [{ "tool": "read", "path": "crates/app/superdev/src/main.rs" }],
        "forbiddenTools": ["sokf_search", "sokf_graph"],
        "outcomes": ["no-unnecessary-knowledge-retrieval"]
      }
    },
    {
      "id": "concept-edit",
      "sandbox": "repository-copy",
      "prompt": "Clarify the Pi adapter paragraph in knowledge/architecture.md without changing its meaning.",
      "expect": {
        "prerequisiteCalls": [
          { "tool": "read", "path": "knowledge/schemas/*.md" },
          { "tool": "read", "path": "knowledge/architecture.md" }
        ],
        "orderedCalls": [{ "tool": "edit", "path": "knowledge/architecture.md" }],
        "outcomes": ["final-validation-passes"]
      }
    },
    {
      "id": "multi-step-knowledge-change",
      "sandbox": "repository-copy",
      "prompt": "Create two test concepts where the first depends on the second. It is acceptable for the first write to be temporarily invalid; finish both and leave SOKF valid.",
      "expect": {
        "orderedCalls": [
          { "tool": "read", "path": ["knowledge/schemas/*.md"] },
          { "tool": "write", "path": "knowledge/*.md" },
          { "tool": "write", "path": "knowledge/*.md" }
        ],
        "outcomes": ["applied-invalid-is-not-retried", "final-validation-passes"]
      }
    },
    {
      "id": "knowledge-producing-code-change",
      "sandbox": "repository-copy",
      "prompt": "Change SOKF CLI behavior so read defaults to 100 lines, including tests and the affected canonical project knowledge.",
      "expect": {
        "orderedCalls": [{ "tool": "sokf_search" }, { "tool": "edit", "path": "crates/*" }, { "tool": "edit", "path": "knowledge/*.md" }],
        "outcomes": ["code-tests-and-knowledge-stay-in-sync", "final-validation-passes"]
      }
    },
    {
      "id": "new-project-decision",
      "sandbox": "repository-copy",
      "prompt": "Decide whether the Pi adapter should keep read aliases and record the decision for future contributors.",
      "expect": {
        "orderedCalls": [{ "tool": "sokf_search" }, { "tool": "write", "path": "knowledge/*.md" }],
        "forbiddenPaths": ["DECISION*.md", "notes/**"],
        "outcomes": ["decision-recorded-in-sokf"]
      }
    },
    {
      "id": "outward-facing-documentation",
      "sandbox": "repository-copy",
      "prompt": "Add a user-facing Pi setup guide and update canonical project knowledge without copying the guide into SOKF.",
      "expect": {
        "orderedCalls": [{ "tool": "write", "path": "docs/*.md" }, { "tool": "edit", "path": "knowledge/*.md" }],
        "outcomes": ["knowledge-summary-is-concise", "knowledge-summary-cites-outward-document"]
      }
    },
    {
      "id": "format-question",
      "sandbox": "repository-copy",
      "prompt": "Explain whether SOKF permits an agent to reorder verified entries and quote the normative rule.",
      "expect": {
        "orderedCalls": [{ "tool": "read", "path": ".agents/sokf/SPEC.md" }],
        "forbiddenTools": ["edit", "write"],
        "outcomes": ["answer-uses-normative-specification"]
      }
    },
    {
      "id": "unknown-concept-id",
      "sandbox": "repository-copy",
      "prompt": "Read knowledge/command-router-policy.md and explain it. If that path is missing, recover using sokf_search rather than scanning the filesystem.",
      "expect": {
        "orderedCalls": [{ "tool": "read", "path": "knowledge/command-router-policy.md" }, { "tool": "sokf_search" }],
        "forbiddenTools": ["edit", "write"],
        "outcomes": ["search-recovery", "no-broad-filesystem-scan"]
      }
    },
    {
      "id": "missing-sokf-store",
      "sandbox": "repository-without-knowledge",
      "prompt": "Find project architecture knowledge, then read README.md even if no SOKF store exists.",
      "expect": {
        "orderedCalls": [{ "tool": "sokf_search" }, { "tool": "read", "path": "README.md" }],
        "forbiddenTools": ["edit", "write"],
        "outcomes": ["missing-store-error-is-clear", "ordinary-read-still-works"]
      }
    }
  ]
}
